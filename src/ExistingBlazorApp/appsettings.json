{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_HOST;Database=ExistingBlazorApp;User ID=YOUR_SQL_USER;******;TrustServerCertificate=True",
    "Redis": "YOUR_REDIS_HOST:6379,******"
  },
  "BlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=REPLACE_WITH_SECRET;EndpointSuffix=core.windows.net",
    "ContainerName": "uploads",
    "MaxUploadBytes": 10485760
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
